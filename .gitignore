# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Android release signing
android/keystore/*.jks
android/key.properties

# Android signing / local IDE
.idea/
key.properties
android/key.properties.save
android/app/*.jks
android/app/google-services.json

# ATLAS cleanup temporary folders
.tmp-pre-h2-untracked/

# ATLAS national data lake - keep large raw datasets outside Git
data/lgd/
data/postal/
data/geography/coordinates/raw/geo-place-coordinate-candidates.json
data/geography/coordinates/import/geo-place-coordinate-import.json
data/geography/coordinates/raw/*.tmp

# Local audit outputs
audits/
