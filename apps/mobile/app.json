{
  "expo": {
    "name": "3Bigha",
    "slug": "3bigha-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "threebigha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow 3Bigha to protect your signed-in session."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow 3Bigha to capture your live selfie and work or workplace evidence."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow 3Bigha to verify the live operating location you submit during registration."
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.threebigha.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F2EA"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.threebigha.mobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "extra": {
      "architecture": "canonical-native-foundation",
      "mobSprint": "MOB-13"
    }
  }
}
